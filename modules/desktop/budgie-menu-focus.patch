 				break;
 			case Budgie.PanelPosition.RIGHT:
 				ctx.move_to(0, 0);
 				ctx.line_to(0, h);
+				ctx.line_to(overlap, h);
 				ctx.line_to(w, h / 2.0);
+				ctx.line_to(overlap, 0);
 				break;
 			case Budgie.PanelPosition.BOTTOM:
 			default:
 				ctx.move_to(0, 0);
 				ctx.line_to(w, 0);
+				ctx.line_to(w, overlap);
 				ctx.line_to(w / 2.0, h);
+				ctx.line_to(0, overlap);
